#!/usr/bin/env python3
"""Static repo checks (no device, no AI). Run locally or in CI: bin/qa-check [app ...]

1. Coverage: every `### <ID>` in apps/<app>/specs/*/spec.md appears as a `### <ID>` in some
   apps/<app>/tests/**/CASES.md. A missing ID is an error. A case without a <ID>.yaml flow is a warning
   (the PR may be a Stage 3 PR).
2. known-bug: every flow tagged `known-bug` must name its bug ticket in a `# Known-bug: <KEY-123>` header
   line. A tag without a real ticket key is an error.
"""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HEADING = re.compile(r"^### (\S+)\s*$", re.M)
TICKET = re.compile(r"^#\s*Known-bug:\s*([A-Z][A-Z0-9]+-\d+)\b", re.M)
TAG = re.compile(r"^\s*-\s*known-bug\s*$|^tags:\s*\[.*\bknown-bug\b.*\]", re.M)

errors, warnings = [], []


def check_app(app: Path) -> None:
    spec_ids = {}
    for spec in sorted(app.glob("specs/*/spec.md")):
        for rid in HEADING.findall(spec.read_text()):
            spec_ids[rid] = spec
    case_ids = {}
    for cases in app.glob("tests/**/CASES.md"):
        for rid in HEADING.findall(cases.read_text()):
            case_ids[rid] = cases
    for rid, spec in sorted(spec_ids.items()):
        if rid not in case_ids:
            errors.append(f"{app.name}: rule {rid} ({spec.relative_to(ROOT)}) has no entry in any CASES.md")
    for rid, cases in sorted(case_ids.items()):
        if not (cases.parent / f"{rid}.yaml").exists():
            warnings.append(f"{app.name}: case {rid} has no flow {rid}.yaml yet")
    for flow in sorted(app.glob("tests/**/*.yaml")):
        text = flow.read_text()
        if TAG.search(text) and not TICKET.search(text):
            errors.append(f"{flow.relative_to(ROOT)}: tagged known-bug but no '# Known-bug: <KEY-123>' header")


def main() -> int:
    apps = [ROOT / "apps" / a for a in sys.argv[1:]] or sorted((ROOT / "apps").glob("*/app.config.yml"))
    apps = [a.parent if a.name == "app.config.yml" else a for a in apps]
    for app in apps:
        check_app(app)
    for w in warnings:
        print(f"warning: {w}")
    for e in errors:
        print(f"error: {e}")
    print(f"qa-check: {len(apps)} app(s), {len(errors)} error(s), {len(warnings)} warning(s)")
    return 1 if errors else 0


sys.exit(main())
